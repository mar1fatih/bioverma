+.form { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 24px; padding: clamp(18px, 4vw, 32px);
+  box-shadow: 0 16px 40px var(--shadow-color); }
+
+.summary { display: flex; align-items: center; gap: 14px; padding: 12px 14px; margin-bottom: 22px; border-radius: 18px;
+  background: var(--color-primary-subtle); border: 1px solid var(--color-border); }
+.thumb { width: 56px; height: 56px; object-fit: contain; flex: none; border-radius: 12px; background: var(--color-surface); padding: 4px; }
